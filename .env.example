# Configurazione per Docker Compose di Urania Web

# Porta esposta sull'host (default 3100)
PORT=3100

# Cartella sul sistema host contenente il database books.db
DB_DIR_HOST=/home/giovortu/Documents/Projects/Urania/build/database

# (Opzionale) Cartella della libreria Calibre sull'host
CALIBRE_DIR_HOST=/home/giovortu/Calibre Library

# (Opzionale) Percorso del database app.db di Calibre-Web sull'host
CALIBRE_WEB_DB_HOST=/home/giovortu/Documents/Projects/calibre-web/app.db

# (Opzionale) URL per contattare Calibre-Web (host.docker.internal punta all'host)
CALIBRE_WEB_URL=http://host.docker.internal:8083
