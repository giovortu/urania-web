[Unit]
Description=Book Manager Web Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/book-manager
Environment="NODE_ENV=production"
ExecStart=/usr/bin/node /opt/book-manager/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=book-manager

[Install]
WantedBy=multi-user.target
